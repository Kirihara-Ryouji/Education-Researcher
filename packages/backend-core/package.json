{
  "name": "@brainpilot/backend-core",
  "version": "0.2.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Education Researcher backend — local study APIs and BrainPilot-compatible agent orchestration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugins",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kirihara-Ryouji/Education-Researcher.git",
    "directory": "packages/backend-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node ./dist/server.js"
  },
  "dependencies": {
    "@brainpilot/plugin-sdk": "^0.2.3",
    "@brainpilot/protocol": "^0.2.3",
    "@brainpilot/runtime": "^0.2.3",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289"
  },
  "optionalDependencies": {
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "jszip": "^3.10.2"
  }
}
